# Server Port (default: 3000)
PORT=3000

# Optional Python PyTorch ML Microservice URL (when running ml/inference_server.py locally)
# Leave empty or unset to use the built-in Node.js mathematical ACN calibration engine.
ML_SERVICE_URL="http://127.0.0.1:8000"

# GEMINI_API_KEY: Optional if extending with Gemini API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="http://localhost:3000"
